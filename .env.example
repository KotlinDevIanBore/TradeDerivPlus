# Copy to .env and adjust. Defaults run fully offline with mock market data
# and a simulated M-Pesa lifecycle, so nothing external is required to develop.

APP_ENV=development
PORT=8080
# Comma-separated. 5173 is the app you run; 5174 is the one the browser
# suite starts for itself (see web/playwright.config.ts).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

DATABASE_URL=postgres://tdp:tdp@localhost:5434/tradederivplus?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Market feed. USE_MOCK_FEED=true generates a local random walk per symbol.
USE_MOCK_FEED=true
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_APP_ID=1089

# Digit contracts trading surface. Default ON when unset.
# Seeds app_settings.digit_contracts_enabled only if the row is missing;
# an existing DB value is never overwritten on boot.
#   DIGIT_CONTRACTS_ENABLED=false  → seed/resolve off
#   DIGIT_CONTRACTS_ENABLED=true   → seed/resolve on (same as unset)
# After bootstrap, flip without redeploy:
#   UPDATE app_settings SET value = 'false', updated_at = now()
#   WHERE key = 'digit_contracts_enabled';
# DIGIT_CONTRACTS_ENABLED=true

# Limits on every digit contract, automated or placed by hand.
DIGIT_MAX_STAKE=100
DIGIT_MAX_OPEN_PER_ACCOUNT=5

# Automated ("AUTO") trading. Default OFF when unset, and unlike the digit flag
# this one gates the service, not just the UI: with it off, POST /bot/runs is
# refused, not merely hidden.
#
# Seeded into app_settings the same way, so it only takes effect on a database
# that has not seen it before. After that, use the admin console (Dashboard →
# "Turn auto runs back on" / "Stop all auto runs"), which is audited, or:
#   UPDATE app_settings SET value = 'true', updated_at = now()
#   WHERE key = 'bot_enabled';
# BOT_ENABLED=false
#
# Comma-separated user IDs. Empty plus enabled means everyone; a non-empty list
# is the staged rollout.
# BOT_ALLOWLIST=
#
# Real-money runs. Leave off until the payout table in internal/models has been
# replaced: it is marked "NOT final for real-money use", and with this false a
# run on a real account is refused with a reason the ticket shows.
# BOT_REAL_MONEY_ENABLED=false

# Bounds on a run itself. BOT_MAX_RUNS is what caps settlement load, since every
# bot contract settles on the single feed goroutine; 50 was load-tested on a
# developer machine, so size it to the host rather than copying it.
BOT_MIN_INTERVAL_MS=1000
BOT_MAX_RUNS=50

# M-Pesa. USE_MOCK_MPESA=true simulates the STK callback after a few seconds,
# failing roughly one deposit in six so the failure UI is exercisable.
USE_MOCK_MPESA=true
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8080/api/v1/mpesa/callback

# Withdrawals. OFF by default, and this is the one flag that must stay off until
# the M-Pesa B2C payout exists: a withdrawal debits the balance immediately and
# nothing can yet pay the customer, so an enabled withdrawal takes money and pays
# nobody. Like the bot flags it only SEEDS app_settings.withdrawals_enabled on a
# fresh database; after that the row owns the value.
# WITHDRAWALS_ENABLED=false
#
# Ceilings, in KES, per transaction and per account per day. PROVISIONAL and a
# product decision: both sit under Daraja's own B2C limits so a refusal happens
# at validation rather than as a payout failure after the customer is debited.
# Before these existed a withdrawal had no upper bound at all.
MAX_WITHDRAW_KES=150000
MAX_WITHDRAW_DAY_KES=300000

# STK reconciliation. A pass asks Daraja about deposits whose callback has not
# arrived, and credits only when Daraja says plainly that the customer paid.
# The three numbers are PROVISIONAL — guesses at what Daraja tolerates, until
# scripts/daraja_probe.py has been run (docs/investigation-reports/
# stk-reconciliation-plan.md §2.5). The shape is not: never query immediately,
# widen, stop eventually. MIN_AGE is floored at 60s so the pass can never reach
# a deposit the mock callback (4–9s) is about to settle; GIVE_UP must be longer
# than MIN_AGE. After GIVE_UP a row is left for an operator, not queried.
# MPESA_RECONCILE_EVERY=1m
# MPESA_RECONCILE_MIN_AGE=3m
# MPESA_RECONCILE_GIVE_UP=24h

# Money
KES_PER_USD=129.50
MIN_DEPOSIT_KES=50
MAX_DEPOSIT_KES=150000
DEMO_STARTING_BALANCE=10000

# Signal bot
SIGNAL_INTERVAL=2m

# Observability. Both are optional: with no Sentry DSN error reporting is a
# no-op, and /metrics is unauthenticated only if METRICS_TOKEN is empty
# (production refuses to boot without it).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0
# Generate with: openssl rand -base64 32
# Prometheus reads the same value from deploy/prometheus/metrics_token
METRICS_TOKEN=

# Refresh cookies. COOKIE_SECURE must be true in production. COOKIE_DOMAIN is
# empty for host-only cookies in development; in production set it to the
# registrable domain shared by the web app and the API, or SameSite=Strict
# will stop the cookie ever being sent.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Auth rate limiting. These defaults are the production ones. Raise them only
# for a test suite that registers many users in a row.
AUTH_RATE_EVERY=3s
AUTH_RATE_BURST=10
